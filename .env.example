# Server-side only. Leave unset for local/offline mode.
OPENAI_API_KEY=
# Capability tiers are configured independently so model names can change without code edits.
OPENAI_TIER_1_MODEL=gpt-5.6-sol
OPENAI_TIER_2_MODEL=gpt-5.6-sol
OPENAI_TIER_3_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# "manual" records Jamie's release authority and requires an external merge receipt.
# Change to "github" only when the explicit Approve and merge action should invoke the authenticated GitHub CLI.
WORKBENCH_REPOSITORY_MODE=manual
PORT=4173
