{
  "schemaVersion": 1,
  "id": "OA-KNOWLEDGE-001",
  "title": "Governed Workbench Knowledge Source Manifest",
  "status": "proposed",
  "version": "0.2",
  "owner": "Jamie Peppard",
  "authorityRule": "The source artefact status is authoritative. Only approved or published methodology may provide normative instructions. Recorded decisions provide authority only for their exact bounded decision. Proposed, draft and external material may inform analysis but cannot override approved meaning.",
  "statusAuthority": {
    "approved": {
      "effectiveState": "approved",
      "normative": true
    },
    "published": {
      "effectiveState": "approved",
      "normative": true
    },
    "recorded": {
      "effectiveState": "retained-decision",
      "normative": false
    },
    "proposed": {
      "effectiveState": "proposed-evidence",
      "normative": false
    },
    "draft": {
      "effectiveState": "draft-evidence",
      "normative": false
    },
    "idea": {
      "effectiveState": "idea-evidence",
      "normative": false
    },
    "superseded": {
      "effectiveState": "retained-history",
      "normative": false
    },
    "rejected": {
      "effectiveState": "retained-history",
      "normative": false
    },
    "retired": {
      "effectiveState": "retained-history",
      "normative": false
    },
    "unlabelled": {
      "effectiveState": "context-only",
      "normative": false
    }
  },
  "sources": [
    {
      "id": "authoritative-approved-methodology",
      "label": "Authoritative approved methodology",
      "kind": "repository",
      "authority": "methodology",
      "paths": [
        "CHARTER.md",
        "methodology/**/*.md",
        "evolution/**/*.md"
      ],
      "normativeStatuses": [
        "approved",
        "published"
      ]
    },
    {
      "id": "project-governance-context",
      "label": "Project and governance context",
      "kind": "repository",
      "authority": "project-context",
      "paths": [
        "README.md",
        "GOVERNANCE.md",
        "ROADMAP.md",
        "PROJECT-PRIORITIES.md",
        "CHANGELOG.md",
        "AGENTS.md",
        "STEERING.md",
        "docs/purpose/**/*.md",
        "docs/steering/**/*.md",
        "projects/*.yml",
        "prompts/*.yml",
        "prompts/**/*.md",
        "product/**/*.md"
      ],
      "normativeStatuses": [
        "approved",
        "published"
      ]
    },
    {
      "id": "retained-decisions-and-learning",
      "label": "Retained decisions and learning",
      "kind": "repository",
      "authority": "bounded-decision-or-learning",
      "paths": [
        "decisions/**/*.md",
        "feedback/**/*.md",
        "docs/recovery/**/*.md",
        "docs/recovery/*.yml",
        "pilots/**/*.md"
      ],
      "normativeStatuses": []
    },
    {
      "id": "proposed-and-draft-evidence",
      "label": "Proposed and draft evidence",
      "kind": "repository",
      "authority": "evidence-only",
      "paths": [
        "proposals/**/*.md",
        "brand/**/*.md",
        "brand/**/*.json",
        "app/knowledge-source-manifest.json",
        "app/operations-bible.v0.1.json",
        "app/work-profiles.v0.1.json",
        "knowledge/**/*.json",
        "templates/**/*.md"
      ],
      "normativeStatuses": []
    },
    {
      "id": "external-evidence",
      "label": "Connected external evidence",
      "kind": "connected",
      "authority": "external-evidence",
      "paths": [],
      "normativeStatuses": []
    }
  ],
  "chunking": {
    "strategy": "markdown-heading",
    "maximumCharacters": 2400,
    "minimumCharacters": 80,
    "retainHeadingPath": true
  },
  "retrieval": {
    "baseline": "sqlite-fts5",
    "optionalSemanticProvider": "openai-embeddings",
    "separateVectorServiceRequired": false,
    "maximumResults": 8,
    "approvedNormativeBoost": 4,
    "exactTitleBoost": 3
  }
}
