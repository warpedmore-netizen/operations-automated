{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operations-automated.local/schemas/methodology-contract-v0.1.json",
  "id": "OA-KNOWLEDGE-CONTRACT-001",
  "title": "Operations Automated Methodology Learning and Delivery Contract Schema",
  "status": "proposed",
  "version": "0.1",
  "description": "Proposed machine contract. Human-readable approved artefacts retain authority over methodology meaning.",
  "$defs": {
    "approvalState": {
      "const": "not-approved",
      "description": "Application, feedback, synthesis and proposal records cannot create approval."
    },
    "sourceReference": {
      "type": "object",
      "required": ["path", "artefact_id", "version", "status", "hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artefact_id": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["idea", "draft", "proposed", "approved", "published", "superseded", "rejected", "retired", "recorded", "unlabelled"] },
        "hash": { "type": "string", "minLength": 1 },
        "normative": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "knowledgeSnapshot": {
      "type": "object",
      "required": ["snapshot_id", "source_ref", "baseline_version", "sources"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "baseline_version": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } }
      },
      "additionalProperties": true
    },
    "application": {
      "type": "object",
      "required": [
        "methodology_version", "relevant_components", "knowledge_snapshot", "user_context",
        "evidence", "assumptions", "uncertainty", "result", "options", "recommendation",
        "authority_required", "case_test", "feedback_route", "approval_state"
      ],
      "properties": {
        "methodology_version": { "type": "string", "minLength": 1 },
        "relevant_components": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "knowledge_snapshot": { "$ref": "#/$defs/knowledgeSnapshot" },
        "user_context": { "type": "object" },
        "evidence": { "type": "array" },
        "assumptions": { "type": "array" },
        "uncertainty": { "type": "string" },
        "result": {},
        "options": { "type": "array" },
        "recommendation": { "type": "string" },
        "authority_required": { "type": "string" },
        "case_test": {},
        "feedback_route": { "type": "string" },
        "approval_state": { "$ref": "#/$defs/approvalState" }
      },
      "additionalProperties": true
    },
    "learningSignal": {
      "type": "object",
      "required": [
        "signal_id", "source_reference", "source_type", "source_date", "permission_boundary", "confidentiality_boundary",
        "original_wording", "context", "evidence", "evidence_limitations", "ai_interpretation",
        "affected_components", "related_signals", "disposition", "resulting_record", "outcome_review_trigger",
        "approval_state"
      ],
      "properties": {
        "signal_id": { "type": "string", "minLength": 1 },
        "source_reference": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_date": { "type": "string", "minLength": 1 },
        "permission_boundary": { "type": "string", "minLength": 1 },
        "confidentiality_boundary": { "type": "string", "minLength": 1 },
        "original_wording": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "evidence": { "type": "array" },
        "evidence_limitations": { "type": "string" },
        "ai_interpretation": { "type": "string" },
        "affected_components": { "type": "array", "items": { "type": "string" } },
        "related_signals": { "type": "array", "items": { "type": "string" } },
        "disposition": {
          "enum": [
            "already-covered", "answer-only-correction", "clarification", "example-or-guidance-need",
            "more-evidence", "methodology-change-candidate", "product-change-candidate",
            "separate-project-candidate", "urgent-review", "no-action"
          ]
        },
        "resulting_record": { "type": ["string", "null"] },
        "outcome_review_trigger": { "type": "string" },
        "approval_state": { "$ref": "#/$defs/approvalState" }
      },
      "additionalProperties": true
    },
    "synthesis": {
      "type": "object",
      "required": ["signal_ids", "theme", "sources", "summary", "recommendation", "limitations", "status", "approval_state"],
      "properties": {
        "signal_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "theme": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 2 },
        "summary": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "minItems": 1 },
        "status": { "const": "proposed" },
        "approval_state": { "$ref": "#/$defs/approvalState" }
      },
      "additionalProperties": true
    },
    "changeProposal": {
      "type": "object",
      "required": [
        "source_feedback", "related_feedback", "current_approved_meaning", "proposed_meaning",
        "rationale", "evidence_strength", "counter_tests", "disagreements", "alternatives",
        "affected_components", "affected_products_and_prompts", "migration", "tests", "risks",
        "recommendation", "exact_decision_required", "approval_state"
      ],
      "properties": {
        "source_feedback": { "type": "string", "minLength": 1 },
        "related_feedback": { "type": "array" },
        "current_approved_meaning": { "type": "string", "minLength": 1 },
        "proposed_meaning": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_strength": { "type": "string", "minLength": 1 },
        "counter_tests": { "type": "array", "minItems": 1 },
        "disagreements": { "type": "array" },
        "alternatives": { "type": "array", "minItems": 1 },
        "affected_components": { "type": "array" },
        "affected_products_and_prompts": { "type": "array" },
        "migration": { "type": "string" },
        "tests": { "type": "array", "minItems": 1 },
        "risks": { "type": "array", "minItems": 1 },
        "recommendation": { "type": "string", "minLength": 1 },
        "exact_decision_required": { "type": "string", "minLength": 1 },
        "approval_state": { "$ref": "#/$defs/approvalState" }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "required": [
        "release_id", "approver", "scope", "version", "release_date", "conditions",
        "effective_content", "superseded_content", "affected_prompts", "affected_products",
        "migration_requirements", "distribution_destinations", "source_commit_sha"
      ],
      "properties": {
        "release_id": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "release_date": { "type": "string", "minLength": 1 },
        "conditions": { "type": "string" },
        "effective_content": { "type": "array" },
        "superseded_content": { "type": "array" },
        "affected_prompts": { "type": "array" },
        "affected_products": { "type": "array" },
        "migration_requirements": { "type": "array" },
        "distribution_destinations": { "type": "array" },
        "source_commit_sha": { "type": "string", "minLength": 7 }
      },
      "additionalProperties": true
    },
    "outcomeReview": {
      "type": "object",
      "required": [
        "review_id", "release_id", "expected_outcome", "observed_outcome", "evidence", "result",
        "learning", "next_disposition", "reviewer", "review_date"
      ],
      "properties": {
        "review_id": { "type": "string", "minLength": 1 },
        "release_id": { "type": "string", "minLength": 1 },
        "expected_outcome": { "type": "string", "minLength": 1 },
        "observed_outcome": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array" },
        "result": { "enum": ["met", "partly-met", "not-met", "harmful", "unknown"] },
        "learning": { "type": "string", "minLength": 1 },
        "next_disposition": { "$ref": "#/$defs/learningSignal/properties/disposition" },
        "reviewer": { "type": "string", "minLength": 1 },
        "review_date": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
